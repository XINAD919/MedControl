{
  "name": "MedAI – WhatsApp Verification Send",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "medai-whatsapp-verify",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000003",
      "name": "Webhook Entry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "medai-whatsapp-verify-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "auth-check",
              "leftValue": "={{ $json.headers['x-api-key'] }}",
              "rightValue": "={{ $env.WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "auth-wa-0003-4000-8000-000000000013",
      "name": "Check Auth",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300],
      "notes": "Solo el backend MedAI puede invocar este webhook. Actualizar si cambia WEBHOOK_SECRET."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.24.66.234:4001/api/sendPoll",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "*/*"
            },
            {
              "name": "X-Api-Key",
              "value": "={{ $env.WAHA_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": \"{{ $json.body.notify_id }}@c.us\",\n  \"id\": null,\n  \"reply_to\": null,\n  \"poll\": {\n    \"name\": \"¿Eres tú verificando tu cuenta en MedControl?\",\n    \"options\": [\"Sí, soy yo\", \"No fui yo\"],\n    \"multipleAnswers\": false\n  },\n  \"session\": \"{{ $json.body.session }}\"\n}",
        "options": {}
      },
      "id": "d4e5f6a7-0004-4000-8000-000000000004",
      "name": "Send Verification Poll",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [720, 200],
      "notes": "WAHA API key: mover a n8n Credentials → Header Auth para no tenerla en el JSON exportado"
    }
  ],
  "connections": {
    "Webhook Entry": {
      "main": [
        [
          {
            "node": "Check Auth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Auth": {
      "main": [
        [
          {
            "node": "Send Verification Poll",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
